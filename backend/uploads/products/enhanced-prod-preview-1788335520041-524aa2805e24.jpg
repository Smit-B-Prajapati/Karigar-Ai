<svg xmlns="http://www.w3.org/2000/svg" width="800" height="800" viewBox="0 0 800 800">
  <defs>
    <filter id="hdStudioFilter" x="-10%" y="-10%" width="120%" height="120%">
      <feColorMatrix type="matrix" values="
        1.15  0.00  0.00  0.02  0
        0.00  1.15  0.00  0.02  0
        0.00  0.00  1.15  0.02  0
        0.00  0.00  0.00  1.00  0"/>
      <feComponentTransfer>
        <feFuncR type="linear" slope="1.1" intercept="-0.02"/>
        <feFuncG type="linear" slope="1.1" intercept="-0.02"/>
        <feFuncB type="linear" slope="1.1" intercept="-0.02"/>
      </feComponentTransfer>
    </filter>
  </defs>
  <!-- Amazon Studio Pure White Background -->
  <rect width="800" height="800" fill="#FFFFFF"/>
  <!-- Studio Soft Pedestal Floor Shadow -->
  <ellipse cx="400" cy="720" rx="300" ry="40" fill="rgba(0, 0, 0, 0.10)"/>
  <!-- Product Image Centered 100% Intact -->
  <image href="data:image/jpeg;base64," x="60" y="60" width="680" height="680" preserveAspectRatio="xMidYMid meet" filter="url(#hdStudioFilter)"/>
</svg>